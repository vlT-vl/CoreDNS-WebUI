PORT=3000

# Tutte le variabili PUBLIC_* vengono servite a runtime al frontend via GET /env.js → window.ENV
# I nomi vengono convertiti in camelCase: PUBLIC_API_URL → window.ENV.apiUrl
PUBLIC_API_URL=/api
PUBLIC_NODE_NAME=coredns-node
PUBLIC_BRIDGE_PORT=3000
PUBLIC_APP_TITLE=CoreDNS Manager
PUBLIC_REFRESH_INTERVAL=0
# PUBLIC_AUTH_ENABLED è gestito automaticamente da AUTH_ENABLED — non metterlo qui

# Backend-only — mai esposto al frontend
AUTH_ENABLED=false
ADMIN_USER=admin
ADMIN_PASS=changeme

# Backend-only — URL della CLI corednsctl che espone le API su :8081
BRIDGE_URL=http://127.0.0.1:8081
